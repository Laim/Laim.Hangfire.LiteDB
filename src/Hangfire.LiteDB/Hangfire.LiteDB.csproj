<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep the assembly/namespace unchanged so consuming applications do not need code changes. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Hangfire.LiteDB</AssemblyName>
    <PackageId>Laim.Hangfire.LiteDB</PackageId>
    <Version>1.0.0</Version>
    <Authors>codeyu;Laim</Authors>
    <Owners>laim</Owners>
    <Title>Laim.Hangfire.LiteDB</Title>
    <Description>LiteDB storage provider for Hangfire. Maintained fork of Hangfire.LiteDB.</Description>
    <PackageTags>Hangfire;LiteDB;Storage;BackgroundJobs</PackageTags>
    <Copyright>Copyright (c) 2017 zhu yu; Copyright (c) 2026 Laim McKenzie</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/laim/Laim.Hangfire.LiteDB</PackageProjectUrl>
    <RepositoryUrl>https://github.com/laim/Laim.Hangfire.LiteDB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>
</Project>
